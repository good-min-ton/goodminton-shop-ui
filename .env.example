# Copy to .env.local for local development. On Vercel these are project
# environment variables.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, not read
# at runtime: changing one in the Vercel dashboard does nothing until the project
# is redeployed. Worth knowing when the backends move, which they do on every
# ngrok restart unless the tunnel has a reserved domain.
#
# Use https:// for anything deployed. The Vercel site is served over HTTPS, so a
# browser blocks an http:// API call as mixed content before it is ever sent.

# Spring shop API
NEXT_PUBLIC_API_URL=http://localhost:8080

# RAG chatbot service (FastAPI)
NEXT_PUBLIC_RAG_API_URL=http://localhost:8081

# Serve chat answers over SSE so they render as they generate. The RAG service
# has its own CHAT_STREAM_ENABLED flag and returns 404 for /chat/stream unless it
# is on too, so turn that one on first.
NEXT_PUBLIC_CHAT_STREAM_ENABLED=false

# Google OAuth Client ID — CÙNG một giá trị với GOOGLE_CLIENT_ID của shop-api.
# Client ID không phải bí mật (nó nằm sẵn trong bundle trình duyệt); thứ bảo vệ
# luồng này là danh sách "Authorized JavaScript origins" bên Google, phải khai
# đúng origin của frontend: http://localhost:3000 và tên miền Vercel.
# Không cần khai redirect URI: trình duyệt nhận ID token thẳng từ Google, nên
# tên miền tunnel của backend đổi bao nhiêu lần cũng không ảnh hưởng.
# Để trống thì nút Google không hiện.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
